<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.NestedIncludeMapper">

    <sql id="cols">id, name</sql>
    <sql id="base_cols"><include refid="cols"/>, status, created_at</sql>
    <sql id="full_cols"><include refid="base_cols"/>, updated_at</sql>

    <select id="selectAll">
        SELECT <include refid="full_cols"/> FROM nested_table
    </select>
</mapper>
